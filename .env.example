# Copy to .env and fill in. Docker Compose reads this file automatically.
# Get a key at https://openrouter.ai/keys — the application starts without one,
# but the advisor cannot answer until it has one.
OPENROUTER_API_KEY=

# The models, if you want something other than the defaults. Any OpenRouter
# model identifier works. The conversation model is the one the traveler talks
# to; the utility model is the cheaper one behind titles, summaries and search.
# CONVERSATION_MODEL=anthropic/claude-sonnet-5
# UTILITY_MODEL=anthropic/claude-haiku-4.5

# The origins the frontend is served from, comma-separated. Needed when it is on
# a host of its own, which is then built with VITE_API_BASE_URL set to this
# backend's origin, and whenever Accounts are on, because a sign-in is only
# accepted from these. The combined image leaves it empty unless Accounts are
# on, and then lists its own origin, such as http://localhost:8000.
# FRONTEND_ORIGINS=http://localhost:5173

# Accounts, through a Clerk development instance. Without both backend keys
# everyone is a Guest, and a frontend built without the publishable key hides
# signing in. All three are on the Clerk dashboard's API keys page. The public
# key is the PEM one, on one line with \n between its lines if need be.
# CLERK_PUBLIC_KEY=
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=

# Host ports, if 5432 or 8000 are already taken on your machine.
# DB_PORT=5432
# APP_PORT=8000
